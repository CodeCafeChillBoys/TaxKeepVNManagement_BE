{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "taxkeepSwaggerRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/taxkeep/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },

      "authRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "authApiRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "authApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },

      "profileRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/profile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/profile/{**catch-all}"
          }
        ]
      },
      "profileApiRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/profile/{**catch-all}"
        }
      },
      "profileApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/profile/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/profile/{**catch-all}"
          }
        ]
      },

      "dependentsRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/dependents/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/dependents/{**catch-all}"
          }
        ]
      },
      "dependentsApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/dependents/{**catch-all}"
        }
      },

      "dependentRulesRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/dependent-rules/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/dependent-rules/{**catch-all}"
          }
        ]
      },
      "dependentRulesApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/dependent-rules/{**catch-all}"
        }
      },

      "incomeSourcesRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/income-sources/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/income-sources/{**catch-all}"
          }
        ]
      },
      "incomeSourcesApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/income-sources/{**catch-all}"
        }
      },

      "notificationsRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/notifications/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/v1/notifications/{**catch-all}"
          }
        ]
      },
      "notificationsApiV1Route": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/v1/notifications/{**catch-all}"
        }
      },

      "generalApiRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/api/{**catch-all}"
        }
      },
      "taxkeepCatchAllRoute": {
        "ClusterId": "taxkeepCluster",
        "Match": {
          "Path": "/taxkeep/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "taxkeepCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5023"
          }
        }
      }
    }
  }
}
